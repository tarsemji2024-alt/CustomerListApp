<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp"
        android:paddingTop="10dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ग्राहक का नाम" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="पिता का नाम (Father name)" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eFather" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="लोकेशन / गाँव" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eLoc" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text|textCapWords" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="नियर बाई (Near by)" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eNear" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text|textCapWords" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="मोबाइल नंबर" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eMob" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="phone" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="वर्क ऑर्डर नंबर" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eWo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RSN" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eRsn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textCapCharacters" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="प्रकार (ODU / IDU / STB)" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eType" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textCapCharacters" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="रिमार्क / स्थिति" android:textSize="12sp" android:textColor="#A0A0AA" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <EditText android:textColor="#FFFFFF" android:id="@+id/eSt" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:inputType="text" />
            <Button android:id="@+id/btnPreset" android:layout_width="wrap_content"
                android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp"
                android:text="▼ Select" android:textAllCaps="false" android:textColor="#FFFFFF"
                android:background="@drawable/glass_button" android:stateListAnimator="@null"
                android:paddingLeft="12dp" android:paddingRight="12dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="STB सीरियल" android:textSize="12sp" android:textColor="#A0A0AA" />
        <EditText android:textColor="#FFFFFF" android:id="@+id/eStb" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textCapCharacters" />
    </LinearLayout>
</ScrollView>
